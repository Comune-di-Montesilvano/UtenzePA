{
  "name": "montesilvano-fe",
  "version": "0.0.0",
  "license": "EUPL-1.2",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4300 --poll 2000 --source-map=true",
    "build": "ng build --configuration production",
    "docker:dev:win": "docker build --target dev -t montesilvano-fe-dev . && docker run -it --rm --init --name montesilvano-fe-dev -p 4300:4300 -v %cd%:/app -v /app/node_modules montesilvano-fe-dev",
    "docker:dev:linux": "docker build --target dev -t montesilvano-fe-dev . && docker run -it --rm --init --name montesilvano-fe-dev -p 4300:4300 -v $(pwd):/app -v /app/node_modules montesilvano-fe-dev",
    "docker:prod": "docker build --target prod -t montesilvano-fe-prod . && docker run -p 80:80 montesilvano-fe-prod"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@ng-idle/core": "^16.0.0",
    "@ng-idle/keepalive": "^16.0.0",
    "@sentry/angular": "^10.69.0",
    "axios": "1.19.0",
    "class-transformer": "^0.5.1",
    "font-awesome": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@types/axios": "^0.14.4",
    "@types/jasmine": "~6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.3"
  }
}
