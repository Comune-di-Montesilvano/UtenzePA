{
  "name": "montesilvano-fe",
  "version": "0.0.0",
  "license": "EUPL-1.2",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4300 --poll 2000 --source-map=true",
    "build": "node scripts/check-guida.mjs && ng build --configuration production",
    "docker:dev:win": "docker build --target dev -t montesilvano-fe-dev . && docker run -it --rm --init --name montesilvano-fe-dev -p 4300:4300 -v %cd%:/app -v /app/node_modules montesilvano-fe-dev",
    "docker:dev:linux": "docker build --target dev -t montesilvano-fe-dev . && docker run -it --rm --init --name montesilvano-fe-dev -p 4300:4300 -v $(pwd):/app -v /app/node_modules montesilvano-fe-dev",
    "docker:prod": "docker build --target prod -t montesilvano-fe-prod . && docker run -p 80:80 montesilvano-fe-prod",
    "lint": "ng lint",
    "test": "ng test --watch=false"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ng-idle/core": "^16.0.0",
    "@ng-idle/keepalive": "^16.0.0",
    "@sentry/angular": "^11.12.0",
    "axios": "1.21.1",
    "class-transformer": "^0.5.1",
    "font-awesome": "^4.7.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "marked": "^18.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}