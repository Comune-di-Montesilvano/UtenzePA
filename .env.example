# UtenzePA — Esempio configurazione
# Copia questo file in .env e adatta i valori al tuo ambiente.
# Non committare mai .env con credenziali reali nel repository!

# ── Compose ───────────────────────────────────────────────────────────────────
# SOLO SVILUPPO: attiva l'override con bind mount e hot-reload.
# Windows usa ";" come separatore, Linux/macOS usa ":".
# In produzione (Portainer/podman) NON impostare questa variabile.
#COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Tag delle immagini di produzione (es. v1.2.0). Default: latest.
IMAGE_TAG=latest

# ── Porte esterne ─────────────────────────────────────────────────────────────
DOCKER_API_PORT=3000
DOCKER_FRONTEND_PORT=4300

# URL pubblico del backend, raggiungibile dal BROWSER (non dalla rete Docker
# interna) — es. https://utenze.comune.montesilvano.pe.it/api/v1. Iniettata
# a runtime nel frontend (nessun rebuild per cambiare ambiente). Vuoto: il
# frontend usa il valore statico compilato in environment.ts.
API_URL=

# ── MySQL ─────────────────────────────────────────────────────────────────────
# ATTENZIONE: la password finisce nella stringa di connessione del backend
# senza escaping. Usa SOLO caratteri alfanumerici (niente $ @ # ^ / : %).
MYSQL_PASSWORD=change-me-in-production-openssl-rand-hex-24
MYSQL_DB=mydatabase

# Mai true in produzione pubblica (espone /api-docs).
SWAGGER=false

# error|warn|info|debug|verbose — debug/verbose senza rebuild, solo restart.
LOG_LEVEL=info

# Origini ammesse per CORS, separate da virgola (es. https://utenze.comune.montesilvano.pe.it).
CORS_ORIGIN=http://localhost:4300

# ── Secret (obbligatori in produzione) ───────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-hex-32
COOKIE_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Genera con: openssl rand -hex 16
# Token condiviso fuori-banda con chi deve creare il primo utente Admin
# tramite il wizard /setup: senza questo token la creazione del primo Admin
# è rifiutata, anche con OTP email corretto (evita che chiunque raggiunga
# l'endpoint a DB vuoto possa auto-nominarsi Admin).
SETUP_BOOTSTRAP_TOKEN=change-me-in-production-use-openssl-rand-hex-16

# ── Email SMTP (invio notifiche, reset password) ─────────────────────────────
HOST_EMAIL=
PORT_EMAIL=587
USERNAME_EMAIL=
PASSWORD_EMAIL=
SMTP_SECURE_PROTOCOL=true

# ── Backup DB — schedulazione cron, retention, dimensioni massime ─────────────
# Formato: standard cron (@nestjs/schedule) — es. "0 0 * * *" per mezzanotte.
BACKUP_CRON_SCHEDULE=0 0 * * *
# Giorni di retention per i backup (es. 30 = mantieni ultimi 30 giorni).
BACKUP_RETENTION_DAYS=30
# Dimensione massima dump backup in MB (es. 500 = max 500 MB per file .sql.gz).
BACKUP_MAX_SIZE_MB=500
# Dimensione massima file di restore/import in MB (es. 50 = max 50 MB caricato).
IMPORT_MAX_SIZE_MB=50
