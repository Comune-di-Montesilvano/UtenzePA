# UtenzePA — Esempio configurazione
# Copia questo file in .env e adatta i valori al tuo ambiente.
# Non committare mai .env con credenziali reali nel repository!

# ── Compose ───────────────────────────────────────────────────────────────────
# SOLO SVILUPPO: attiva l'override con bind mount e hot-reload.
# Windows usa ";" come separatore, Linux/macOS usa ":".
# In produzione (Portainer/podman) NON impostare questa variabile.
#COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml

# Tag delle immagini di produzione (es. v1.2.0). Default: latest.
IMAGE_TAG=latest

# ── Porte esterne ─────────────────────────────────────────────────────────────
DOCKER_API_PORT=3000
DOCKER_FRONTEND_PORT=4300

# ── MySQL ─────────────────────────────────────────────────────────────────────
# ATTENZIONE: la password finisce nella stringa di connessione del backend
# senza escaping. Usa SOLO caratteri alfanumerici (niente $ @ # ^ / : %).
MYSQL_PASSWORD=change-me-in-production-openssl-rand-hex-24
MYSQL_DB=mydatabase

# Mai true in produzione pubblica (espone /api-docs).
SWAGGER=false

# ── Secret (obbligatori in produzione) ───────────────────────────────────────
# Genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-hex-32
COOKIE_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ── Email SMTP (invio notifiche, reset password) ─────────────────────────────
HOST_EMAIL=
PORT_EMAIL=587
USERNAME_EMAIL=
PASSWORD_EMAIL=
SMTP_SECURE_PROTOCOL=true
