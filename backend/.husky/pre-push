#!/bin/sh

echo "🚀 Running pre-push checks..."

# 1. Run full test suite
echo "\n🧪 Running complete test suite..."
npm test -- --coverage --passWithNoTests

if [ $? -ne 0 ]; then
    echo "\n❌ PUSH BLOCKED: Tests failed!"
    echo "💡 All tests must pass before pushing to remote.\n"
    exit 1
fi

# 2. Build check
echo "\n🔨 Checking if project builds..."
npm run build

if [ $? -ne 0 ]; then
    echo "\n❌ PUSH BLOCKED: Build failed!"
    echo "💡 Fix build errors before pushing.\n"
    exit 1
fi

# 3. Docker build check
echo "\n🐳 Checking if Docker build succeeds..."
docker build --target build -t nestjs-template-build-check .

if [ $? -ne 0 ]; then
    echo "\n❌ PUSH BLOCKED: Docker build failed!"
    echo "💡 Fix Docker build errors before pushing.\n"
    exit 1
fi

# Clean up the build check image
docker rmi nestjs-template-build-check 2>/dev/null || true

echo "✅ Docker build check passed!"

