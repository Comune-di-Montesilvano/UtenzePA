#!/bin/sh

echo "📝 Validating commit message..."
npm exec commitlint -- --edit "$1"

if [ $? -ne 0 ]; then
    echo "\n❌ COMMIT BLOCKED: Invalid commit message format!"
    echo "\n💡 Commit message must follow Conventional Commits format:"
    echo "   <type>[optional scope]: <description>"
    echo "\n📚 Examples:"
    echo "   feat: add user authentication"
    echo "   fix(api): resolve database connection issue"
    echo "   docs: update README with API examples"
    echo "   style: format code with prettier"
    echo "   refactor: simplify user service logic"
    echo "   test: add unit tests for auth module"
    echo "   chore: update dependencies"
    echo "\n🔧 Allowed types: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert\n"
    exit 1
fi

echo "✅ Commit message validated successfully!"