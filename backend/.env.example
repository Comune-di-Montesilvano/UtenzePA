# backend/.env.example — variabili lette dal backend (NestJS), letto quando
# si lancia il backend fuori da Docker Compose root (es. `pnpm run start:dev`).
# In produzione via Docker Compose, i valori arrivano dal root .env/
# docker-compose.yml (vedi root .env.example) e questo file non viene usato.
# Copia in backend/.env e adatta i valori.

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development|staging|production|test. Validato all'avvio (EnvValidator).
# Default 'development' se assente. In 'development' i placeholder dei secret
# sotto sono ammessi (assertProductionSecrets non fa nulla); in qualsiasi altro
# ambiente, se JWT_ACCESS_SECRET/COOKIE_SECRET/MYSQL_PASSWORD sono ancora ai
# valori placeholder l'app rifiuta di avviarsi.
NODE_ENV=development

# Porta HTTP dell'app. Default 3000 se assente.
PORT=3000

# error|warn|info|debug|verbose. Default 'info' se assente.
LOG_LEVEL=info

# Mai true in produzione pubblica (espone /api-docs).
SWAGGER=true

# Origini ammesse per CORS, separate da virgola. Default
# 'http://localhost:4300' se assente. In deploy Docker Compose è gestita a
# livello root (.env/docker-compose.yml, non qui) — questo valore conta solo
# per un backend lanciato fuori da Docker (es. `pnpm run start:dev`).
CORS_ORIGIN=http://localhost:4300

# Certificati HTTPS locali (dist/cert/key.pem, dist/cert/cert.pem), usati solo
# se NODE_ENV non è 'development' e questa var è valorizzata. Non usato nei
# deploy Docker Compose (TLS terminato altrove, es. reverse proxy). Lasciare
# vuoto/assente nel caso comune.
ENABLE_HTTPS_PROPRIETARY=

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Stessi nomi in ogni ambiente. Default 'mysql'/3306/'root'/'password'/
# 'mydatabase' se assenti (comodi per Docker Compose, NON per produzione).
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
# ATTENZIONE: obbligatoria in produzione (assertProductionSecrets rifiuta
# l'avvio se resta al placeholder sotto, per qualunque NODE_ENV != development).
# Genera con: openssl rand -hex 24
MYSQL_PASSWORD=change-me-in-production-openssl-rand-hex-24
MYSQL_DB=mydatabase

# Escape hatch TypeORM per iterazione rapida in dev — bypassano le migration,
# MAI true in produzione. Default false se assenti.
SYNCHRONIZE=false
DROPSCHEMA=false
# true forza sia SYNCHRONIZE che DROPSCHEMA a true (usato dal data-importer per
# ripartire da schema pulito). Default false se assente.
IMPORT_DATA=false

# ── JWT / auth ────────────────────────────────────────────────────────────────
# ATTENZIONE: obbligatoria in produzione (stesso meccanismo di MYSQL_PASSWORD
# sopra). Se assente il modulo auth usa 'defaultSecret' come fallback silenzioso
# (auth.module.ts) — non affidarsi mai a questo fallback fuori da development.
# Genera con: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Firma i cookie (cookie-parser). ATTENZIONE: obbligatoria in produzione, stesso
# meccanismo di JWT_ACCESS_SECRET/MYSQL_PASSWORD sopra.
# Genera con: openssl rand -hex 32
COOKIE_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Token condiviso fuori-banda con chi deve creare il primo utente Admin tramite
# il wizard /setup: senza questo token la creazione del primo Admin è
# rifiutata, anche con OTP email corretto.
# Genera con: openssl rand -hex 16
SETUP_BOOTSTRAP_TOKEN=change-me-in-production-use-openssl-rand-hex-16

# ── Email SMTP (invio notifiche, reset password, OTP) ────────────────────────
HOST_EMAIL=
PORT_EMAIL=587
USERNAME_EMAIL=
PASSWORD_EMAIL=
SMTP_SECURE_PROTOCOL=true

# ── Backup DB — schedulazione cron, retention, dimensioni massime ────────────
# Formato: standard cron (@nestjs/schedule). Default mezzanotte se assente.
BACKUP_CRON_SCHEDULE=0 0 * * *
# Giorni di retention per i backup. Default 30 se assente.
BACKUP_RETENTION_DAYS=30
# Dimensione massima dump backup in MB. Default 500 se assente.
BACKUP_MAX_SIZE_MB=500
# Cartella dove vengono scritti i dump. Default '<cwd>/backups' se assente.
BACKUP_DIR=

# Dimensione massima file di restore/import in MB. Default 50 se assente.
IMPORT_MAX_SIZE_MB=50

# ── Error tracking (Sentry/GlitchTip) — opzionale ────────────────────────────
# DSN del progetto. Vuoto/assente = tracking disabilitato (instrument.ts).
SENTRY_DSN=
# Tag ambiente riportato negli eventi (es. production, staging).
SENTRY_ENVIRONMENT=
# Abilita l'invio dei log strutturati a Sentry/GlitchTip. Default disabilitato
# se assente.
SENTRY_LOGS=
# Tag versione riportato come "release" Sentry e mostrato in UI (footer/
# sidebar, health.service.ts). Normalmente valorizzata a build-time dal
# Dockerfile (ARG APP_VERSION, da release.yml), non da .env — lasciare assente
# per un avvio locale.
APP_VERSION=
# Hash commit breve, fallback di getVersion() quando APP_VERSION è assente o
# 'dev' (build non taggata). Come APP_VERSION, valorizzata a build-time dal
# Dockerfile (ARG VCS_REF), non da .env.
VCS_REF=

# ── Infisical (secret manager esterno) — opzionale ───────────────────────────
# Se tutte e tre (CLIENT_ID/CLIENT_SECRET/PROJECT_ID) sono valorizzate,
# InfisicalConfigService prova a recuperare i secret da Infisical invece che
# dalle variabili d'ambiente locali. Assenti = Infisical disabilitato, si usa
# solo process.env (comportamento di default di questo repo).
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
# Default: INFISICAL_ENVIRONMENT, poi NODE_ENV, poi 'development'.
INFISICAL_ENVIRONMENT=
# Default 'https://app.infisical.com' se assente (self-hosted: valorizzare).
INFISICAL_SITE_URL=

# ── Docker/orchestrazione — opzionale ────────────────────────────────────────
# Validata (solo warning se assente) da EnvValidator, non consumata altrove
# dal backend: è la porta host→container gestita a livello root
# (.env/docker-compose.yml, vedi root .env.example) — qui è solo per zittire
# il warning se si lancia il backend con EnvValidator attivo fuori da Docker.
DOCKER_API_PORT=3000
