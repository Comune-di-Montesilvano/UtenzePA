# ============================================
# INFISICAL CONFIGURATION
# ============================================
# These are the only environment variables needed when using Infisical
# All other secrets should be stored in Infisical

# Infisical Machine Identity Credentials
# Get these from: Infisical Dashboard > Project Settings > Machine Identities
INFISICAL_CLIENT_ID=your-client-id-here
INFISICAL_CLIENT_SECRET=your-client-secret-here

# Infisical Project Configuration
INFISICAL_PROJECT_ID=your-project-id-here
INFISICAL_ENVIRONMENT=development
INFISICAL_SITE_URL=https://app.infisical.com

# Node Environment (still needed for configuration selection)
NODE_ENV=development

# Application Port
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=NestJS Template

# ============================================
# MONGODB CONFIGURATION
# ============================================
MONGODB_URI=mongodb://mongodb:27017/nestjs_template

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=b174cbe8b2d35987432251eff83b3fcd3c6b289e998fc922dc6883587d795d6c9b68bf1d9cd76a13c6702d6642898390fd2e0e87f44c1e966acaed5991daa19c
JWT_REFRESH_SECRET=0ffed82b794e129987a0fab933467edab20bc53e9c98e1111c62c7ecb5d931e7beed6e06ba0396dc0b56977f104c2dbc8e58fad1b53446e2867cd81b0619b716
JWT_TWO_FACTOR_SECRET=c8f3a9e2b7d4c1a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3b6d9c2a5f8e3
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# BCRYPT CONFIGURATION
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# RATE LIMITING CONFIGURATION
# ============================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=900000

# ============================================
# ACCOUNT LOCKING CONFIGURATION
# ============================================
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=1800000

# ============================================
# TOKEN EXPIRATION CONFIGURATION
# ============================================
PASSWORD_RESET_TOKEN_EXPIRATION_MS=3600000
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MS=86400000

# ============================================
# TWO-FACTOR AUTHENTICATION CONFIGURATION
# ============================================
TWO_FACTOR_APP_NAME=NestJS Template
TWO_FACTOR_WINDOW=2

# ============================================
# SECURITY CONFIGURATION
# ============================================
# CORS_ORIGIN è gestita solo a livello root (.env / docker-compose.yml),
# non qui: questo file non è la sorgente di verità per quella variabile.
COOKIE_SECRET=ae7b352de966bb3f15bd1a2a519033bcd9d59ecc9dc06d24566865651e793e51
COOKIE_DOMAIN=localhost

# ============================================
# SWAGGER CONFIGURATION
# ============================================
SWAGGER=true

# ============================================
# DOCKER CONFIGURATION
# ============================================
DOCKER_API_PORT=3000
DOCKER_MONGO_PORT=27017
DOCKER_REDIS_PORT=6379

CSV_FOLDER_PATH=

ENCRYPTION_KEY=

USERNAME_EMAIL=
PASSWORD_EMAIL=
HOST_EMAIL=
PORT_EMAIL=
SMTP_SECURE_PROTOCOL=

#TYPEORM
SYNCHRONIZE=false
DROPSCHEMA=false
