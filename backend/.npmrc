# NPM Configuration for NestJS Template

# ============================================
# VERSION ENFORCEMENT
# ============================================
# Enforce Node.js and npm versions defined in package.json
engine-strict=true

# Use package-lock.json for deterministic installs
package-lock=true

# ============================================
# DEPENDENCY MANAGEMENT
# ============================================
# Handle peer dependencies (set to false for strict mode)
# Use true only if you encounter peer dependency conflicts
legacy-peer-deps=false

# Save exact versions (use true for complete reproducibility)
save-exact=false

# ============================================
# REGISTRY & NETWORK
# ============================================
# Registry configuration
registry=https://registry.npmjs.org/

# Prefer offline cache when available
prefer-offline=true

# ============================================
# SECURITY
# ============================================
# Run audit on install
audit=true

# Minimum severity level for audit failures
audit-level=high

# ============================================
# OUTPUT & LOGGING
# ============================================
# Logging level (silent, error, warn, info, verbose, silly)
loglevel=warn

# Show progress during installs
progress=true

# Disable funding messages
fund=false

# Disable update notifier
update-notifier=false
