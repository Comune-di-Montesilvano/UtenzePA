{
  "name": "comune-montesilvano-be",
  "version": "0.0.1",
  "description": "Be del gestionale per il Comune di Montesilvano(PE)",
  "author": "Furlone Francesco",
  "private": true,
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "volta": {
    "node": "26.10.0"
  },
  "scripts": {
    "//== BUILD & START ==": "",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "//== TESTING ==": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "jest --testPathPatterns=src/.*\\.spec\\.ts$",
    "//== CODE QUALITY ==": "",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,md}\"",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "//== SECURITY ==": "",
    "audit:check": "pnpm audit --audit-level=high",
    "//== INFISICAL ==": "",
    "infisical:test": "node scripts/test-infisical.js",
    "//== GIT HOOKS ==": "",
    "prepare": "husky",
    "pre-commit-test": "jest --bail --findRelatedTests --passWithNoTests",
    "//== DOCKER ==": "",
    "docker:prod": "docker compose --env-file .env up --build --force-recreate --remove-orphans -d",
    "docker:prod:stop": "docker compose down",
    "docker:prod:log": "docker compose --env-file .env up --build --force-recreate --remove-orphans",
    "//== LOAD TESTING ==": "",
    "artillery:low": "artillery run artillery/load-test-low.yml",
    "artillery:medium": "artillery run artillery/load-test-medium.yml",
    "artillery:high": "artillery run artillery/load-test-high.yml",
    "artillery:massive": "artillery run artillery/load-test-massive.yml",
    "artillery:all": "pnpm run artillery:low && pnpm run artillery:medium && pnpm run artillery:high && pnpm run artillery:massive",
    "artillery:run": "./scripts/run-load-test.sh"
  },
  "dependencies": {
    "@infisical/sdk": "^5.3.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@sentry/nestjs": "~11.11.0",
    "@sentry/node": "~11.11.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.0",
    "heic-convert": "^2.1.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.11.0",
    "ldapjs": "^3.0.7",
    "mailparser": "^3.14.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfjs-dist": "6.5.438",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.23",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.10",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ldapjs": "^3.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "artillery": "^2.0.34",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@apis/(.*)$": "<rootDir>/apis/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "/node_modules/\\.pnpm/@nestjs\\+passport@[^/]+/node_modules/@nestjs/passport/.*\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ],
      "/node_modules/\\.pnpm/@nestjs\\+jwt@[^/]+/node_modules/@nestjs/jwt/.*\\.js$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ],
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(@nestjs\\+passport@|@nestjs\\+jwt@))"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "apis/auth/auth.service.spec.ts$",
      "apis/backup/backup.controller.spec.ts$"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/*.config.ts",
      "!**/*.example.ts",
      "!**/instrument.ts",
      "!**/*.enum.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/*.schema.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov",
      "html"
    ],
    "testEnvironment": "node"
  }
}
