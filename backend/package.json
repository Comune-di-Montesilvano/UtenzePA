{
  "name": "comune-montesilvano-be",
  "version": "0.0.1",
  "description": "Be del gestionale per il Comune di Montesilvano(PE)",
  "author": "Furlone Francesco",
  "private": true,
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.6.2",
  "volta": {
    "node": "24.8.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "//== BUILD & START ==": "",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "//== TESTING ==": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "jest --testPathPatterns=src/.*\\.spec\\.ts$",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.js",
    "test:integration:watch": "cross-env NODE_ENV=test jest --config jest.integration.config.js --watch",
    "test:integration:cov": "cross-env NODE_ENV=test jest --config jest.integration.config.js --coverage",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:ci": "jest --bail --passWithNoTests",
    "//== CODE QUALITY ==": "",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,md}\"",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "//== SECURITY ==": "",
    "audit:check": "npm audit --audit-level=high",
    "//== INFISICAL ==": "",
    "infisical:test": "node scripts/test-infisical.js",
    "//== GIT HOOKS ==": "",
    "prepare": "husky",
    "pre-commit-test": "jest --bail --findRelatedTests --passWithNoTests",
    "//== DOCKER ==": "",
    "docker:dev": "docker compose -f docker-compose-development.yml --env-file .env up",
    "docker:dev:refresh": "docker compose -f docker-compose-development.yml --env-file .env up --build --force-recreate --remove-orphans",
    "docker:dev:debug": "docker compose -f docker-compose-development.yml --env-file .env run --rm --service-ports api npm run start:debug",
    "docker:dev:stop": "docker compose -f docker-compose-development.yml down",
    "docker:prod": "docker compose --env-file .env up --build --force-recreate --remove-orphans -d",
    "docker:prod:stop": "docker compose down",
    "docker:prod:log": "docker compose --env-file .env up --build --force-recreate --remove-orphans",
    "//== LOAD TESTING ==": "",
    "artillery:low": "artillery run artillery/load-test-low.yml",
    "artillery:medium": "artillery run artillery/load-test-medium.yml",
    "artillery:high": "artillery run artillery/load-test-high.yml",
    "artillery:massive": "artillery run artillery/load-test-massive.yml",
    "artillery:all": "npm run artillery:low && npm run artillery:medium && npm run artillery:high && npm run artillery:massive",
    "artillery:run": "./scripts/run-load-test.sh"
  },
  "dependencies": {
    "@infisical/sdk": "^4.0.6",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "~10.69.0",
    "@sentry/node": "~10.69.0",
    "@sentry/profiling-node": "~10.69.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "axios": "1.13.5",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "clean": "^4.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-csv": "^5.0.5",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^7.0.10",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "speakeasy": "^2.0.0",
    "typeorm": "^0.3.27",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.23",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^7.0.2",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "artillery": "^2.0.26",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.20",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "overrides": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-logs": "^0.204.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/otlp-transformer": "^0.204.0",
    "playwright": "^1.56.1",
    "serialize-javascript": "^7.0.2",
    "tar": "^7.5.0",
    "undici": "^7.19.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@apis/(.*)$": "<rootDir>/apis/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/*.config.ts",
      "!**/*.example.ts",
      "!**/instrument.ts",
      "!**/*.enum.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/*.schema.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov",
      "html"
    ],
    "testEnvironment": "node"
  }
}
