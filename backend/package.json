{
  "name": "comune-montesilvano-be",
  "version": "0.0.1",
  "description": "Be del gestionale per il Comune di Montesilvano(PE)",
  "author": "Furlone Francesco",
  "private": true,
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=24.11.0 <25.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "volta": {
    "node": "24.20.0"
  },
  "scripts": {
    "//== BUILD & START ==": "",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug 0.0.0.0:9229 --watch",
    "start:prod": "node dist/main",
    "//== TESTING ==": "",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:unit": "jest --testPathPatterns=src/.*\\.spec\\.ts$",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.js",
    "test:integration:watch": "cross-env NODE_ENV=test jest --config jest.integration.config.js --watch",
    "test:integration:cov": "cross-env NODE_ENV=test jest --config jest.integration.config.js --coverage",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "test:ci": "jest --bail --passWithNoTests",
    "//== CODE QUALITY ==": "",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json,md}\"",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "//== SECURITY ==": "",
    "audit:check": "pnpm audit --audit-level=high",
    "//== INFISICAL ==": "",
    "infisical:test": "node scripts/test-infisical.js",
    "//== GIT HOOKS ==": "",
    "prepare": "husky",
    "pre-commit-test": "jest --bail --findRelatedTests --passWithNoTests",
    "//== DOCKER ==": "",
    "docker:dev": "docker compose -f docker-compose-development.yml --env-file .env up",
    "docker:dev:refresh": "docker compose -f docker-compose-development.yml --env-file .env up --build --force-recreate --remove-orphans",
    "docker:dev:debug": "docker compose -f docker-compose-development.yml --env-file .env run --rm --service-ports api pnpm run start:debug",
    "docker:dev:stop": "docker compose -f docker-compose-development.yml down",
    "docker:prod": "docker compose --env-file .env up --build --force-recreate --remove-orphans -d",
    "docker:prod:stop": "docker compose down",
    "docker:prod:log": "docker compose --env-file .env up --build --force-recreate --remove-orphans",
    "//== LOAD TESTING ==": "",
    "artillery:low": "artillery run artillery/load-test-low.yml",
    "artillery:medium": "artillery run artillery/load-test-medium.yml",
    "artillery:high": "artillery run artillery/load-test-high.yml",
    "artillery:massive": "artillery run artillery/load-test-massive.yml",
    "artillery:all": "pnpm run artillery:low && pnpm run artillery:medium && pnpm run artillery:high && pnpm run artillery:massive",
    "artillery:run": "./scripts/run-load-test.sh"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "~10.71.0",
    "@sentry/node": "~10.71.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/passport-jwt": "^4.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.2.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^7.0.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "artillery": "^2.0.26",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.20",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@apis/(.*)$": "<rootDir>/apis/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/*.config.ts",
      "!**/*.example.ts",
      "!**/instrument.ts",
      "!**/*.enum.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/*.schema.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov",
      "html"
    ],
    "testEnvironment": "node"
  }
}
